<Window x:Class="PcPowerMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.SettingsTitle}"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Background}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="18">
        <!-- MinHeight fits the tallest tab, so the window does not jump when switching tabs. -->
        <TabControl x:Name="Tabs" Margin="0,0,0,12" MinHeight="600">

            <!-- General -->
            <TabItem Header="{DynamicResource L.TabGeneral}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{DynamicResource L.SetInterval}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Margin="0,4" />

                            <TextBlock Grid.Row="1" Text="{DynamicResource L.SetPsu}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PsuBox" Margin="0,4" />

                            <TextBlock Grid.Row="2" Text="{DynamicResource L.SetTdp}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TdpBox" Margin="0,4" />

                            <TextBlock Grid.Row="3" Text="{DynamicResource L.SetIdle}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="IdleBox" Margin="0,4" />
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{DynamicResource L.SetCpuHint}"
                                       Style="{StaticResource SubText}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.SetLanguage}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="LangAuto" GroupName="Lang" Content="{DynamicResource L.LangAuto}" />
                                <RadioButton x:Name="LangEn" GroupName="Lang" Content="English" />
                                <RadioButton x:Name="LangTr" GroupName="Lang" Content="Türkçe" />
                            </StackPanel>
                            <CheckBox x:Name="CloseToTrayBox" Margin="0,4">
                                <TextBlock Text="{DynamicResource L.SetCloseToTray}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="CsvBox" Content="{DynamicResource L.SetCsv}" Margin="0,0,0,8" />
                            <TextBlock Text="{DynamicResource L.SetCsvFolder}" Style="{StaticResource SubText}" Margin="0,0,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource L.Browse}" Margin="8,0,0,0"
                                        Padding="10,3" Click="Browse_Click" />
                                <TextBox x:Name="FolderBox" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Other components -->
            <TabItem Header="{DynamicResource L.TabOther}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.SetOtherIntro}" Style="{StaticResource SubText}"
                               TextWrapping="Wrap" Margin="2,0,2,10" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBox x:Name="OtherBox" DockPanel.Dock="Right" Width="90" />
                                <RadioButton x:Name="OtherFixedRadio" GroupName="OtherMode"
                                             Content="{DynamicResource L.SetOtherFixedMode}" Checked="OtherMode_Changed" />
                            </DockPanel>
                            <RadioButton x:Name="OtherComponentsRadio" GroupName="OtherMode" Margin="0,0,0,8"
                                         Content="{DynamicResource L.SetOtherComponentsMode}" Checked="OtherMode_Changed" />
                            <Grid x:Name="ComponentGrid" Margin="22,0,0,0" />
                            <TextBlock x:Name="ComponentTotal" FontWeight="SemiBold" Margin="22,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Electricity cost -->
            <TabItem Header="{DynamicResource L.TabCost}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L.SetTariff}" Margin="0,0,0,6" />
                            <ListBox x:Name="TariffList" Height="150" SelectionChanged="TariffList_SelectionChanged" />
                            <TextBlock x:Name="TariffDetails" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="SourceLine" Style="{StaticResource SubText}" Margin="0,2,0,0">
                                <Run Text="{DynamicResource L.TariffSource}" /><Run Text=": " />
                                <Hyperlink x:Name="SourceLink" Click="SourceLink_Click" Foreground="{DynamicResource B.Accent}">
                                    <Run x:Name="SourceText" />
                                </Hyperlink>
                            </TextBlock>

                            <StackPanel x:Name="TierPanel" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource L.SetTier}" Margin="0,0,0,4" />
                                <WrapPanel x:Name="TierOptions" />
                                <TextBlock x:Name="TierHint" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <Grid x:Name="ManualPanel" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L.SetManualCurrency}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="CurrencyBox" Margin="0,4" MaxLength="3" CharacterCasing="Upper" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4">
                                    <RadioButton x:Name="ManualFlatRadio" GroupName="ManualMode" Content="{DynamicResource L.SetManualFlat}"
                                                 Checked="ManualMode_Changed" />
                                    <RadioButton x:Name="ManualTouRadio" GroupName="ManualMode" Content="{DynamicResource L.SetManualTou}"
                                                 Checked="ManualMode_Changed" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" x:Name="ManualPriceLabel" Text="{DynamicResource L.SetManualPrice}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ManualPriceBox" Margin="0,4" />
                                <TextBlock Grid.Row="3" x:Name="ManualDayLabel" Text="{DynamicResource L.SetManualDay}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ManualDayBox" Margin="0,4" />
                                <TextBlock Grid.Row="4" x:Name="ManualPeakLabel" Text="{DynamicResource L.SetManualPeak}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ManualPeakBox" Margin="0,4" />
                                <TextBlock Grid.Row="5" x:Name="ManualNightLabel" Text="{DynamicResource L.SetManualNight}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="ManualNightBox" Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TableInfo" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox x:Name="OnlineBox" Content="{DynamicResource L.SetOnline}" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource L.SetOnlineHint}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                            <TextBlock x:Name="OnlineLast" Style="{StaticResource SubText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource B.Unavailable}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Save}" Style="{StaticResource AccentButton}" IsDefault="True"
                    Margin="0,0,8,0" MinWidth="90" Click="Save_Click" />
            <Button Content="{DynamicResource L.Cancel}" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
