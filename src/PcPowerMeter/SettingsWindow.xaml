<Window x:Class="PcPowerMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.SettingsTitle}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource B.Background}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="18">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource L.SetInterval}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" Margin="0,4" />

                <TextBlock Grid.Row="1" Text="{DynamicResource L.SetPsu}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PsuBox" Margin="0,4" />

                <TextBlock Grid.Row="2" Text="{DynamicResource L.SetOther}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="OtherBox" Margin="0,4" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{DynamicResource L.SetOtherHint}"
                           Style="{StaticResource SubText}" Margin="0,0,0,6" />

                <TextBlock Grid.Row="4" Text="{DynamicResource L.SetTdp}" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TdpBox" Margin="0,4" />

                <TextBlock Grid.Row="5" Text="{DynamicResource L.SetIdle}" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="IdleBox" Margin="0,4" />
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{DynamicResource L.SetCpuHint}"
                           Style="{StaticResource SubText}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.SetLanguage}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="LangAuto" GroupName="Lang" Content="{DynamicResource L.LangAuto}" />
                    <RadioButton x:Name="LangEn" GroupName="Lang" Content="English" />
                    <RadioButton x:Name="LangTr" GroupName="Lang" Content="Türkçe" />
                </StackPanel>
                <CheckBox x:Name="CloseToTrayBox" Margin="0,4">
                    <TextBlock Text="{DynamicResource L.SetCloseToTray}" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="CsvBox" Content="{DynamicResource L.SetCsv}" Margin="0,0,0,8" />
                <TextBlock Text="{DynamicResource L.SetCsvFolder}" Style="{StaticResource SubText}" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource L.Browse}" Margin="8,0,0,0"
                            Padding="10,3" Click="Browse_Click" />
                    <TextBox x:Name="FolderBox" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource B.Unavailable}" TextWrapping="Wrap"
                   Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource L.Save}" Style="{StaticResource AccentButton}" IsDefault="True"
                    Margin="0,0,8,0" MinWidth="90" Click="Save_Click" />
            <Button Content="{DynamicResource L.Cancel}" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
