<Window x:Class="PcPowerMeter.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcPowerMeter.Controls"
        Title="{DynamicResource L.UsageTitle}"
        Icon="Assets/app.ico"
        Width="820" Height="800" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Background}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and note -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="{DynamicResource L.UsageTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource L.UsageNote}" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Period totals -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid x:Name="SummaryTable" />
                <TextBlock x:Name="ProjectionText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Daily chart -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.DailyChartTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <controls:DailyChart x:Name="Chart" Height="170" />
            </StackPanel>
        </Border>

        <!-- Monthly summary -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource L.MonthlyTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="MonthlyTable" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TariffText" Style="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DockPanel Grid.Row="1">
                <Button DockPanel.Dock="Right" Content="{DynamicResource L.Close}" MinWidth="90" IsCancel="True" Click="Close_Click" />
                <WrapPanel>
                    <Button Content="{DynamicResource L.ExportHourly}" Margin="0,0,8,0" Click="ExportHourly_Click" />
                    <Button Content="{DynamicResource L.ExportDaily}" Margin="0,0,8,0" Click="ExportDaily_Click" />
                    <Button Content="{DynamicResource L.ResetHistory}" Margin="0,0,8,0" Click="ResetHistory_Click" />
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
