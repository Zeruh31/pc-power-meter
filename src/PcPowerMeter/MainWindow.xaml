<Window x:Class="PcPowerMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcPowerMeter.Controls"
        Title="{DynamicResource L.AppTitle}"
        Icon="Assets/app.ico"
        Width="800" Height="760" MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.Background}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Big wall power value -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource L.WallLabel}" FontSize="15"
                               Foreground="{DynamicResource B.SubText}" VerticalAlignment="Center" />
                    <ContentControl x:Name="WallTag" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="WallValue" Text="–" FontSize="64" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Accent}" />
                    <TextBlock Text="W" FontSize="28" Margin="8,0,0,12" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource B.Accent}" />
                </StackPanel>
                <TextBlock x:Name="WallDetail" Style="{StaticResource SubText}" FontSize="13" />
                <TextBlock x:Name="CostText" Style="{StaticResource SubText}" FontSize="13" Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ResetButton" Content="{DynamicResource L.Reset}" Margin="0,0,8,0" Click="Reset_Click" />
                <Button x:Name="UsageButton" Content="{DynamicResource L.Usage}" Margin="0,0,8,0" Click="Usage_Click" />
                <Button x:Name="SettingsButton" Content="{DynamicResource L.Settings}" Click="Settings_Click" />
            </StackPanel>
        </Grid>

        <!-- Warnings -->
        <StackPanel x:Name="WarningPanel" Grid.Row="1" />

        <!-- Component table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid x:Name="Table" />
        </Border>

        <!-- Live chart -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource L.ChartTitle}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    <WrapPanel x:Name="Legend" HorizontalAlignment="Right" />
                </DockPanel>
                <controls:PowerChart x:Name="Chart" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SessionText" Style="{StaticResource SubText}" />
            <TextBlock x:Name="CsvText" Grid.Row="1" Style="{StaticResource SubText}" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,3,0,0" x:Name="OpenFolderLink">
                <Hyperlink Click="OpenFolder_Click" Foreground="{DynamicResource B.Accent}">
                    <Run Text="{DynamicResource L.OpenFolder}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource L.Note}"
                       Style="{StaticResource SubText}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
